# Copy to .env and fill in. Get a free key at https://www.themoviedb.org/settings/api
# Either the v3 "API Key" or the v4 "Read Access Token" works.
TMDB_API_KEY=
# How many videos to take from a pasted YouTube playlist (in playlist order). Default 25.
# YT_PLAYLIST_MAX=25
# What the secret menu's first roll after a server start always picks (start of a movie title). Blank disables it.
# FIRST_ROLL_TITLE=Terminator 2
# Format ladders: YT_FORMAT for ordinary videos (default up to 1080p), YT_FORMAT_CAPPED for
# playlist videos and music (default up to 720p). yt-dlp -f syntax.
